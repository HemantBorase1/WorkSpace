package DSA.vectordemo;

import java.util.Arrays;
import java.util.NoSuchElementException;

public class MyVector {

	private int a[]=null;
	private int index=-1;
	MyVector()
	{
		this(10);
    }

	public MyVector(int size) {
		// TODO Auto-generated constructor stub
	 a = new int[size];	
     }
	public boolean isEmpty() {
		return index==-1;
	}
	private boolean isfull()
	{
		return index==a.length-1;
	}
	public int size() {
	    int count=0;
	    for(int i=0;i<a.length;i++) {
	    	if(a[i]!=0)
	    	{
	    		count++;
	    	}
	    }
	    return count;
	}
	
	public String toString() {
		StringBuilder sb=new StringBuilder("[");
		if(!isEmpty()) {
			for(int i=0;i<=index;i++) {
				sb.append(a[i]);
				sb.append(",");
			}
			sb.deleteCharAt(sb.length()-1);
		}
		sb.append("]");
		return sb.toString();
		
	}
	public void add(int obj)
	{
		if(isfull()) {
			a=Arrays.copyOf(a, a.length*2);
		
		}
		a[++index]=obj;
	}
	
	public void addall(MyVector v2) {
		
		if(this.index+v2.index>this.a.length) {
			this.a=Arrays.copyOf(this.a, this.a.length*2);
		}
		int size1=this.size();
		int size2=v2.size();
		int j=0;
		for(int i=size1;i<size1+size2;i++) {
			
			a[i]=v2.a[j];
			j++;
		}
	}
	
	public boolean remove(int obj)
	{
		if(!isEmpty()) {
			boolean b=false;
			int i=0;
			for( i=0;i<=index;i++) {
				if(a[i]==obj) {
					b=true;
					break;
				}
			}
			for(i++;i<=index;i++) {
				a[i-1]=a[i];
			}
			if(!b)
				throw new NoSuchElementException("Object Not Found");
			index--;
			return b;
		}
		throw new IndexOutOfBoundsException("Vector is Empty!!");
	}
	public int removeAt(int index) {
		if(index<=this.index) {
			int value=a[index];
			for(int i=index+1;i<=this.index;i++) {
				a[i-1]=a[i];
			}
			this.index--;
			return value;
		}else {
			throw new IndexOutOfBoundsException("Index Should be <"+(this.index+1));
		}
	}
	public void insert(int index,int obj) {
		if(index<=this.index) {
			if(isfull()) {
				a=Arrays.copyOf(a, a.length*2);
			}
			for(int i=this.index;i>=index;i--) {
				a[i+1]=a[i];
			}
			a[index]=obj;
			this.index++;
		}
		else {
			throw new IndexOutOfBoundsException("Index Should be <"+(this.index+1));
		}
	}
	public boolean contains(int obj)
	{
		boolean b=false;
		if(isEmpty()) {
			System.out.println("Vector is Empty");
		}
		else
		{
			for(int i=0;i<index;i++) {
				if(a[i]==obj)
				{
					b=true;
					break;
				}
			}
		}
		return b;
	}
	
	
}
