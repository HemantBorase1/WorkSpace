package DSA.LinkListDemo;
import java.util.NoSuchElementException;

public class MyLinkedList<E> {

	private Node<E> head=null;
    private boolean isEmpty() {
    	return head==null;
    }
    
    public String toString() {
    	StringBuilder sb=new StringBuilder("[");
    	if(!isEmpty()) {
    		Node<E> temp=head;
    		while(temp!=null) {
    			sb.append(temp.data);
    			sb.append(",");
    			temp=temp.next;
    		}
    		sb.deleteCharAt(sb.length()-1);
    	}
    	sb.append("]");
    	return sb.toString();
    }
    public int size() {
    	int count=0;
    	Node <E> temp=head;
    	while(temp!=null) {
    		count++;
    		temp=temp.next;
    	}
    	return count;
    }
    public void addLast(E data)
    {
    	Node<E> newNode=new Node(data);
    	if(isEmpty()) {
    		head=newNode;
    	}
    	else {
    		Node<E> temp=head;
    		while(temp.next!=null) {
    			temp=temp.next;
    		}
    		temp.next=newNode;
    	}
    }
    public void addFirst(E data) {
    	Node<E> newNode=new Node(data);
    	if(isEmpty()) {
    		head=newNode;
    	}
    	else {
    		newNode.next=head;
    		head=newNode;
    	}
    }
    public void insert(int index,E data) {
    	if(index>=0 && index<size()) {
    		if(index==0) {
    			addFirst(data);
    		}
    		else {
    			Node<E> newNode=new Node(data);
    			Node<E> temp=head;
    			int count=0;
    			while(count<index-1) {
    				count++;
    				temp=temp.next;
    			}
    			newNode.next=temp.next;
    			temp.next=newNode;
    		}
    	}else
    		throw new IndexOutOfBoundsException();
    }
    public E removeFirst() {
    	if(!isEmpty()) {
    		E data = head.data;
    		head=head.next;
    		return data;
    	}else
    		throw new NoSuchElementException();
    }
    public E removeLast() {
    	if(!isEmpty()) {
    		if(head.next==null)
    			return removeFirst();
    		else {
    			Node<E> temp=head;
    			while(temp.next.next!=null) {
    				temp=temp.next;
    			}
    			E data=temp.next.data;
    			temp.next=null;
    			return data;
    		}
    		else
    			throw new NoSuchElementException();
    	}
    }
    
}