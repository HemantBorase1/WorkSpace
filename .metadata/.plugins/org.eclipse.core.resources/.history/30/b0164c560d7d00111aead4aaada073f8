package DSA.LinkListDemo;

public class MyLinkedList<E> {

	private Node<E> head=null;
    private boolean isEmpty() {
    	return head==null;
    }
    public void addLast(E data)
    {
    	Node<E> newNode=new Node(data);
    	if(isEmpty()) {
    		head=newNode;
    	}
    	else {
    		Node<E> temp=head;
    		while(temp.next!=null) {
    			temp=temp.next;
    		}
    		temp.next=newNode;
    	}
    }
}