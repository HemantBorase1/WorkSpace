package DSA.LinkListDemo;

public class MyLinkedList<E> {

	private Node<E> head=null;
    private boolean isEmpty() {
    	return head==null;
    }
    
    public String toString() {
    	StringBuilder sb=new StringBuilder("[");
    	if(!isEmpty()) {
    		Node<E> temp=head;
    		while(temp!=null) {
    			sb.append(temp.data);
    			sb.append(",");
    			temp=temp.next;
    		}
    		sb.deleteCharAt(sb.length()-1);
    	}
    	sb.append("]");
    	return sb.toString();
    }
    public int size() {
    	int count=0;
    	Node <E> temp=head;
    	while(temp!=null) {
    		count++;
    		temp=temp.next;
    	}
    	return count;
    }
    public void addLast(E data)
    {
    	Node<E> newNode=new Node(data);
    	if(isEmpty()) {
    		head=newNode;
    	}
    	else {
    		Node<E> temp=head;
    		while(temp.next!=null) {
    			temp=temp.next;
    		}
    		temp.next=newNode;
    	}
    }
}